<header class="navbar-wrapper" id="navbar">
    <div class="navbar-content">

        <div class="logo-section">
            <a href="/">
                <img src="logos/drdev-logo__transparent.svg" alt="DR Codeworks" title="DR Codeworks" />
            </a>
        </div>

        <nav>
            <ul class="nav-items" id="navItems">
                <li><a class="nav-link" href="/#about">about</a></li>
                <li><a class="nav-link" href="/#experience">experience</a></li>
                <li><a class="nav-link" href="/#arborkin">arborkin</a></li>
                <li><a class="nav-link" href="/#technicalskills">skills</a></li>
                <li><a class="nav-link nav-link--page" href="/consulting">consulting</a></li>
                <li><a class="nav-link nav-link--page" href="/webdesign">web design</a></li>
                <li><a class="nav-link nav-link--archive" href="/archive">archive ↗</a></li>
            </ul>
        </nav>

        <a href="mailto:doug.rosenberg@gmail.com" class="nav-cta" aria-label="Contact Doug Rosenberg">
            <span class="nav-cta__text">get in touch</span>
            <span class="nav-cta__arrow">↗</span>
        </a>

        <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
            <span></span><span></span><span></span>
        </button>

    </div>
</header>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) InitializeNavbar();
    }

    private void InitializeNavbar() { }
}

<script suppress-error="BL9992">
    (function () {
        const navbar   = document.getElementById('navbar');
        const navItems = document.getElementById('navItems');
        const navToggle = document.getElementById('navToggle');

        window.addEventListener('scroll', () => {
            navbar?.classList.toggle('scrolled', window.scrollY > 50);
        }, { passive: true });

        if (navToggle) {
            navToggle.addEventListener('click', () => {
                const open = navItems?.classList.toggle('active');
                navToggle.classList.toggle('open', open);
            });
        }

        // Close menu on any nav link or CTA click
        document.querySelectorAll('.nav-link, .nav-link--page, .nav-link--archive, .nav-cta').forEach(link => {
            link.addEventListener('click', () => {
                navItems?.classList.remove('active');
                navToggle?.classList.remove('open');
            });
        });

        // Active section tracking
        const sections = document.querySelectorAll('section[id]');
        window.addEventListener('scroll', () => {
            let current = '';
            sections.forEach(section => {
                if (window.scrollY >= section.offsetTop - 200) current = section.id;
            });
            document.querySelectorAll('.nav-link').forEach(link => {
                const href = link.getAttribute('href') ?? '';
                const match = href === '#' + current || href === '/#' + current;
                link.classList.toggle('active', match);
            });
        }, { passive: true });
    })();
</script>
