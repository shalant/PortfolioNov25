@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

<header class="navbar-wrapper" id="navbar">
    <div class="navbar-content">

        <div class="logo-section">
            <a href="/#home" target="_top" aria-label="Back to top">
                <img src="logos/drdev-logo__transparent.svg" alt="DR Codeworks" title="DR Codeworks" />
            </a>
        </div>

        <nav>
            <ul class="nav-items" id="navItems">

                <li>
                    <a class="nav-link" href="/#about">
                        <!-- arch — mirrors the arch shapes in the art deco backgrounds -->
                        <svg class="nav-icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                            <path d="M2 13 L2 7.5 A5 5 0 0 0 12 7.5 L12 13"/>
                        </svg>
                        about
                    </a>
                </li>

                <li>
                    <a class="nav-link" href="/#experience">
                        <!-- timeline: dots + lines -->
                        <svg class="nav-icon" viewBox="0 0 14 14" fill="currentColor" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
                            <circle cx="3" cy="4"  r="1.3" stroke="none"/>
                            <line x1="6.5" y1="4"  x2="12" y2="4"/>
                            <circle cx="3" cy="8"  r="1.3" stroke="none"/>
                            <line x1="6.5" y1="8"  x2="10" y2="8"/>
                            <circle cx="3" cy="12" r="1.3" stroke="none"/>
                            <line x1="6.5" y1="12" x2="11" y2="12"/>
                        </svg>
                        experience
                    </a>
                </li>

                <li>
                    <a class="nav-link" href="/#technicalskills">
                        <!-- 2×2 grid of squares -->
                        <svg class="nav-icon" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
                            <rect x="1.5" y="1.5" width="4.5" height="4.5" rx="0.5"/>
                            <rect x="8"   y="1.5" width="4.5" height="4.5" rx="0.5"/>
                            <rect x="1.5" y="8"   width="4.5" height="4.5" rx="0.5"/>
                            <rect x="8"   y="8"   width="4.5" height="4.5" rx="0.5"/>
                        </svg>
                        skills
                    </a>
                </li>

                <!-- divider: sections of this page (above) vs. separate destinations (below) -->
                <li class="nav-divider" role="separator" aria-hidden="true"></li>

                <li>
                    <a class="nav-link nav-link--page" href="/webdesign">
                        <!-- split branch: craft/build, now the featured offering -->
                        <svg class="nav-icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                            <line x1="7" y1="13" x2="7" y2="7"/>
                            <line x1="7" y1="7" x2="3" y2="3"/>
                            <line x1="7" y1="7" x2="11" y2="3"/>
                        </svg>
                        web design
                    </a>
                </li>

                <li>
                    <a class="nav-link nav-link--page" href="/services">
                        <!-- briefcase: services offering -->
                        <svg class="nav-icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="1.5" y="4.5" width="11" height="7.5" rx="1"/>
                            <path d="M5 4.5V3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v1.5"/>
                            <line x1="1.5" y1="7.5" x2="12.5" y2="7.5"/>
                        </svg>
                        services
                    </a>
                </li>

                <li>
                    <a class="nav-link nav-link--page" href="/consulting">
                        <!-- speech bubble: consulting conversation -->
                        <svg class="nav-icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M1.5 2.5 H12.5 V9 H5.5 L3 11.5 V9 H1.5 Z"/>
                        </svg>
                        consulting
                    </a>
                </li>

                <li>
                    <a class="nav-link nav-link--page" href="/blog">
                        <!-- book/blog: open book pages -->
                        <svg class="nav-icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                            <path d="M7 1 L7 13 M1 3 L7 3 M7 3 L13 3 M1 8 L7 8 M7 8 L13 8"/>
                        </svg>
                        blog
                    </a>
                </li>

            </ul>
        </nav>

        <a href="mailto:doug.rosenberg@gmail.com" class="nav-cta" aria-label="Contact Doug Rosenberg">
            <span class="nav-cta__text">get in touch</span>
            <span class="nav-cta__arrow">↗</span>
        </a>

        <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
            <span></span><span></span><span></span>
        </button>

    </div>
</header>

@code {
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("DrNav.init");
        }
        await JS.InvokeVoidAsync("DrNav.highlightActive");
        await JS.InvokeVoidAsync("DrNav.scrollToHash");
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await JS.InvokeVoidAsync("DrNav.highlightActive");
        await JS.InvokeVoidAsync("DrNav.scrollToHash");
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
