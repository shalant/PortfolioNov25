<style>
    /* Modern Gradient Navbar */
    .navbar-wrapper {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: linear-gradient(135deg, rgba(44, 62, 80, 0.95) 0%, rgba(26, 176, 156, 0.1) 100%);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(26, 176, 156, 0.2);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    }

    .navbar-wrapper.scrolled {
        background: linear-gradient(135deg, rgba(44, 62, 80, 0.98) 0%, rgba(26, 176, 156, 0.15) 100%);
        box-shadow: 0 12px 48px rgba(0, 0, 0, 0.2);
    }

    .navbar-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 3rem;
        gap: 3rem;
    }

    /* Logo Section */
    .logo-section {
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }

    .logo-section a {
        display: block;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .logo-section a:hover {
        transform: scale(1.05);
    }

    .logo-section img {
        height: 180px;
        width: auto;
        transition: height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        filter: drop-shadow(0 4px 12px rgba(26, 176, 156, 0.2));
        object-fit: contain;
    }

    .navbar-wrapper.scrolled .logo-section img {
        height: 120px;
    }

    /* Navigation */
    .nav-items {
        display: flex;
        align-items: center;
        gap: 2.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
        flex: 1;
        justify-content: flex-end;
    }

    .nav-items li {
        position: relative;
    }

    .nav-link {
        font-family: 'Montserrat', 'Poppins', sans-serif;
        font-weight: 500;
        font-size: 1rem;
        color: #fff !important;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        padding: 0.5rem 0;
        background: none;
        border: none;
        cursor: pointer;
    }

    .nav-link:hover {
        color: #1abc9c !important;
    }

    .nav-link::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 0;
        height: 2px;
        background: linear-gradient(90deg, #1abc9c, #16a085);
        transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .nav-link:hover::after,
    .nav-link.active::after {
        width: 100%;
    }

    /* Dropdown */
    .dropdown-menu {
        background: rgba(44, 62, 80, 0.95);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(26, 176, 156, 0.2);
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
        margin-top: 0.5rem;
    }

    .dropdown-item {
        color: #fff !important;
        font-weight: 500;
        transition: all 0.3s ease;
        background: transparent;
    }

    .dropdown-item:hover {
        background: rgba(26, 176, 156, 0.2);
        color: #1abc9c !important;
    }

    /* Mobile Menu Toggle */
    .nav-toggle {
        display: none;
        background: none;
        border: none;
        color: #fff;
        font-size: 1.5rem;
        cursor: pointer;
        transition: color 0.3s ease;
    }

    .nav-toggle:hover {
        color: #1abc9c;
    }

    /* Responsive */
    @@media (max-width: 1024px) {
        .navbar-content {
            padding: 0.5rem 2rem;
            gap: 1.5rem;
        }

        .logo-section img {
            height: 140px;
        }

        .navbar-wrapper.scrolled .logo-section img {
            height: 100px;
        }

        .nav-items {
            gap: 1.5rem;
        }

        .nav-link {
            font-size: 0.95rem;
        }
    }

    @@media (max-width: 768px) {
        .navbar-content {
            padding: 0.75rem 1rem;
            gap: 1rem;
        }

        .logo-section img {
            height: 110px;
        }

        .navbar-wrapper.scrolled .logo-section img {
            height: 80px;
        }

        .nav-items {
            display: none;
            gap: 0;
            flex-direction: column;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: rgba(44, 62, 80, 0.98);
            backdrop-filter: blur(20px);
            padding: 1rem;
            border-bottom: 1px solid rgba(26, 176, 156, 0.2);
        }

        .nav-items.active {
            display: flex;
        }

        .nav-items li {
            width: 100%;
        }

        .nav-toggle {
            display: block;
        }
    }
</style>

<header class="navbar-wrapper" id="navbar">
    <div class="navbar-content">
        <!-- Logo Section (Left) -->
        <div class="logo-section">
            <a href="#home">
                <img src="logos/drdev-logo.svg" alt="DR Codeworks" title="DR Codeworks" />
            </a>
        </div>

        <!-- Navigation Items (Right) -->
        <nav>
            <ul class="nav-items" id="navItems">
                <li>
                    <a class="nav-link active" href="#home">Home</a>
                </li>
                <li>
                    <a class="nav-link" href="#about">About</a>
                </li>
                <li>
                    <a class="nav-link" href="#experience">Experience</a>
                </li>
                <li class="dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        More
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#technicalskills">Technical Skills</a></li>
                        <li><a class="dropdown-item" href="#casual">Casual</a></li>
                        <li><a class="dropdown-item" href="#consulting">Consulting</a></li>
                        <li><a class="dropdown-item" href="#webdesign">Web Design</a></li>
                    </ul>
                </li>
            </ul>
        </nav>

        <!-- Mobile Toggle -->
        <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">☰</button>
    </div>
</header>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            InitializeNavbar();
        }
    }

    private void InitializeNavbar()
    {
        // This will be called after render
    }
}

<script suppress-error="BL9992">
    document.addEventListener('DOMContentLoaded', function() {
        const navbar = document.getElementById('navbar');
        const navItems = document.getElementById('navItems');
        const navToggle = document.getElementById('navToggle');

        // Scroll listener
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                navbar?.classList.add('scrolled');
            } else {
                navbar?.classList.remove('scrolled');
            }
        }, { passive: true });

        // Mobile menu toggle
        if (navToggle) {
            navToggle.addEventListener('click', () => {
                navItems?.classList.toggle('active');
            });
        }

        // Close mobile menu when link is clicked
        const navLinks = document.querySelectorAll('.nav-link, .dropdown-item');
        navLinks.forEach(link => {
            link.addEventListener('click', () => {
                navItems?.classList.remove('active');
            });
        });

        // Update active nav link on scroll
        const sections = document.querySelectorAll('section[id]');
        window.addEventListener('scroll', () => {
            let current = '';
            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                if (window.scrollY >= sectionTop - 200) {
                    current = section.getAttribute('id');
                }
            });

            navLinks.forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('href') === '#' + current) {
                    link.classList.add('active');
                }
            });
        }, { passive: true });
    });
</script>
