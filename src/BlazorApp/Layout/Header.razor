<header class="navbar-wrapper" id="navbar">
    <div class="navbar-content">

        <div class="logo-section">
            <a href="/#home" target="_top" aria-label="Back to top">
                <img src="logos/drdev-logo__transparent.svg" alt="DR Codeworks" title="DR Codeworks" />
            </a>
        </div>

        <nav>
            <ul class="nav-items" id="navItems">

                <li>
                    <a class="nav-link" href="/#about">
                        <!-- arch — mirrors the arch shapes in the art deco backgrounds -->
                        <svg class="nav-icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                            <path d="M2 13 L2 7.5 A5 5 0 0 0 12 7.5 L12 13"/>
                        </svg>
                        about
                    </a>
                </li>

                <li>
                    <a class="nav-link" href="/#experience">
                        <!-- timeline: dots + lines -->
                        <svg class="nav-icon" viewBox="0 0 14 14" fill="currentColor" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
                            <circle cx="3" cy="4"  r="1.3" stroke="none"/>
                            <line x1="6.5" y1="4"  x2="12" y2="4"/>
                            <circle cx="3" cy="8"  r="1.3" stroke="none"/>
                            <line x1="6.5" y1="8"  x2="10" y2="8"/>
                            <circle cx="3" cy="12" r="1.3" stroke="none"/>
                            <line x1="6.5" y1="12" x2="11" y2="12"/>
                        </svg>
                        experience
                    </a>
                </li>

                <li>
                    <a class="nav-link" href="/#technicalskills">
                        <!-- 2×2 grid of squares -->
                        <svg class="nav-icon" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true">
                            <rect x="1.5" y="1.5" width="4.5" height="4.5" rx="0.5"/>
                            <rect x="8"   y="1.5" width="4.5" height="4.5" rx="0.5"/>
                            <rect x="1.5" y="8"   width="4.5" height="4.5" rx="0.5"/>
                            <rect x="8"   y="8"   width="4.5" height="4.5" rx="0.5"/>
                        </svg>
                        skills
                    </a>
                </li>

                <!-- divider: sections of this page (above) vs. separate destinations (below) -->
                <li class="nav-divider" role="separator" aria-hidden="true"></li>

                <li>
                    <a class="nav-link nav-link--page" href="/webdesign">
                        <!-- split branch: craft/build, now the featured offering -->
                        <svg class="nav-icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                            <line x1="7" y1="13" x2="7" y2="7"/>
                            <line x1="7" y1="7" x2="3" y2="3"/>
                            <line x1="7" y1="7" x2="11" y2="3"/>
                        </svg>
                        web design
                    </a>
                </li>

                <li>
                    <a class="nav-link nav-link--page" href="/services">
                        <!-- briefcase: services offering -->
                        <svg class="nav-icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="1.5" y="4.5" width="11" height="7.5" rx="1"/>
                            <path d="M5 4.5V3a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v1.5"/>
                            <line x1="1.5" y1="7.5" x2="12.5" y2="7.5"/>
                        </svg>
                        services
                    </a>
                </li>

                <li>
                    <a class="nav-link nav-link--page" href="/consulting">
                        <!-- speech bubble: consulting conversation -->
                        <svg class="nav-icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M1.5 2.5 H12.5 V9 H5.5 L3 11.5 V9 H1.5 Z"/>
                        </svg>
                        consulting
                    </a>
                </li>

                <li>
                    <a class="nav-link nav-link--page" href="/blog">
                        <!-- book/blog: open book pages -->
                        <svg class="nav-icon" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                            <path d="M7 1 L7 13 M1 3 L7 3 M7 3 L13 3 M1 8 L7 8 M7 8 L13 8"/>
                        </svg>
                        blog
                    </a>
                </li>

            </ul>
        </nav>

        <a href="mailto:doug.rosenberg@gmail.com" class="nav-cta" aria-label="Contact Doug Rosenberg">
            <span class="nav-cta__text">get in touch</span>
            <span class="nav-cta__arrow">↗</span>
        </a>

        <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
            <span></span><span></span><span></span>
        </button>

    </div>
</header>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) InitializeNavbar();
    }

    private void InitializeNavbar() { }
}

<script suppress-error="BL9992">
    (function () {
        const navbar    = document.getElementById('navbar');
        const navItems  = document.getElementById('navItems');
        const navToggle = document.getElementById('navToggle');

        window.addEventListener('scroll', () => {
            navbar?.classList.toggle('scrolled', window.scrollY > 50);
        }, { passive: true });

        if (navToggle) {
            navToggle.addEventListener('click', () => {
                const open = navItems?.classList.toggle('active');
                navToggle.classList.toggle('open', open);
            });
        }

        document.querySelectorAll('.nav-link, .nav-link--page, .nav-link--archive, .nav-cta').forEach(link => {
            link.addEventListener('click', () => {
                navItems?.classList.remove('active');
                navToggle?.classList.remove('open');
            });
        });

        const trackActive = () => {
            // query lazily — Blazor renders sections after this script fires
            const sections = Array.from(document.querySelectorAll('section[id]'));
            if (!sections.length) return;
            const threshold = (navbar ? navbar.offsetHeight : 80) + 40;
            let current = sections[0].id;
            for (const s of sections) {
                if (s.getBoundingClientRect().top <= threshold) current = s.id;
            }
            document.querySelectorAll('.nav-link').forEach(link => {
                const href = link.getAttribute('href') ?? '';
                link.classList.toggle('active', href === '#' + current || href === '/#' + current);
            });
        };

        // highlight consulting / web design / blog links when on their own page
        // (anything not a "/#section" hash link, which trackActive already handles)
        const highlightPageLink = () => {
            const path = window.location.pathname.replace(/\/$/, '');
            document.querySelectorAll('.nav-link[href]').forEach(link => {
                const href = link.getAttribute('href') ?? '';
                if (href.startsWith('/#')) return;
                link.classList.toggle('active', href.replace(/\/$/, '') === path);
            });
        };
        highlightPageLink();

        // re-scroll to hash after async sections finish rendering
        const scrollToHash = () => {
            const hash = window.location.hash;
            if (!hash) return;
            const el = document.querySelector(hash);
            if (!el) return;
            const offset = (navbar ? navbar.offsetHeight : 80) + 20;
            window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - offset, behavior: 'smooth' });
        };

        window.addEventListener('scroll', trackActive, { passive: true });
        // fire after Blazor finishes rendering its async components
        setTimeout(trackActive, 300);
        // highlight page links (consulting/web design) after Blazor renders
        setTimeout(highlightPageLink, 300);
        setTimeout(highlightPageLink, 800);
        // two-pass scroll: first pass for fast sections, second for slower async ones
        setTimeout(scrollToHash, 400);
        setTimeout(scrollToHash, 1200);
    })();
</script>
