<style>
        .navbar {
        position: sticky;
        top: 0;
        z-index: 1000;
        backdrop-filter: blur(16px);
        background: rgba(255, 255, 255, 0.4);
        padding: 0.75rem 2rem;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

@* 
    .brand {
        font-weight: 600;
        margin-left: 0.5rem;
        color: #1A1A1A;
    }

    .avatar {
        background: linear-gradient(135deg, #0078FF, #8A2BE2);
        border-radius: 50%;
    }

    .nav-link {
        margin: 0 1rem;
        font-weight: 500;
        color: #1A1A1A;
        position: relative;
        text-transform: capitalize;
    }

    .nav-link:hover {
        color: #0078FF;
    }

    .nav-link::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 0%;
        height: 2px;
        background: linear-gradient(to right, #0078FF, #8A2BE2);
        transition: width 0.3s ease;
    }

    .nav-link:hover::after {
        width: 100%;
    }*@
</style> 




