<section class="hero-section" id="home">
    <div class="hero-grid-bg"></div>

    <div class="hero-content">
        <div class="hero-text">
            <span class="hero-eyebrow">// software engineer</span>
            <h1 class="hero-name">@(property?.Name ?? FallbackName)</h1>
            <div class="hero-divider"></div>
            <p class="hero-subtitle">@(property?.Title ?? FallbackTitle)</p>
            <div class="hero-cta">
                <a href="#experience" class="hero-btn hero-btn--primary" target="_top">View Work <span class="hero-btn__arrow" aria-hidden="true">&rarr;</span></a>
                <a href="#about" class="hero-btn hero-btn--ghost" target="_top">About Me</a>
            </div>
        </div>

        <div class="hero-portrait">
            <img src="@(hero?.Src ?? FallbackHeroSrc)" alt="@(hero?.Alt ?? FallbackHeroAlt)" class="hero-portrait__img" width="840" height="1260" />
        </div>
    </div>

    <a href="#about" class="hero-scroll" target="_top" aria-label="Scroll down">
        <img src="images/down-arrow.svg" alt="scroll down" />
    </a>
</section>

@code {
    [Parameter, EditorRequired]
    public required HeroImageService HeroImageService { get; set; }

    [Parameter, EditorRequired]
    public required SitePropertiesService SitePropertiesService { get; set; }

    private const string FallbackName = "douglas rosenberg";
    private const string FallbackTitle = "software engineer building custom web apps and business systems with an eye for design";
    private const string FallbackHeroSrc = "images/DrCorporateHacker.webp";
    private const string FallbackHeroAlt = "Handsome man with glasses";

    private SiteProperties? property;
    private HeroImage? hero;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            property = await SitePropertiesService.GetAsync();
            hero = await HeroImageService.GetHeroAsync(img => img.Name is "home");
        }
        catch (Exception)
        {
            property = null;
            hero = null;
        }
    }
}
