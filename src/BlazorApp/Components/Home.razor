<section class="hero-section" id="home">
    <div class="hero-grid-bg"></div>

    <div class="hero-content">
        <div class="hero-text">
            <span class="hero-eyebrow">// software engineer</span>
            @if (property is null)
            {
                <h1 class="hero-name">&nbsp;</h1>
            }
            else
            {
                <h1 class="hero-name">@property.Name</h1>
            }
            <div class="hero-divider"></div>
            @if (property is not null)
            {
                <p class="hero-subtitle">@property.Title</p>
            }
            <div class="hero-cta">
                <a href="#experience" class="hero-btn hero-btn--primary" target="_top">View Work</a>
                <a href="#about" class="hero-btn hero-btn--ghost" target="_top">About Me</a>
            </div>
        </div>

        <div class="hero-portrait">
            @if (hero is not null)
            {
                <img src="@hero.Src" alt="@hero.Alt" class="hero-portrait__img" />
            }
        </div>
    </div>

    <a href="#about" class="hero-scroll" target="_top" aria-label="Scroll down">
        <img src="images/down-arrow.svg" alt="scroll down" />
    </a>
</section>

@code {
    [Parameter, EditorRequired]
    public required HttpClient Http { get; set; }

    [Parameter, EditorRequired]
    public required HeroImageService HeroImageService { get; set; }

    private SiteProperties? property;
    private HeroImage? hero;

    protected override async Task OnInitializedAsync()
    {
        property = await Http.GetFromJsonAsync<SiteProperties>("sample-data/siteproperties.json");
        hero = await HeroImageService.GetHeroAsync(img => img.Name is "home");
    }
}
