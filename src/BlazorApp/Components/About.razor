<section class="about-section" id="about">
    <div class="about-container">
        <div class="about-header">
            <span class="section-eyebrow">// about me</span>
            <h2 class="about-heading">Who I Am</h2>
        </div>

        @if (aboutMe is null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <div class="about-body">
                <div class="about-bio">
                    <p class="about-description">@aboutMe.Description</p>
                </div>
                <div class="about-skills">
                    <p class="about-skills__label">Core Stack</p>
                    <ul class="about-skills__list">
                        @foreach (var skill in aboutMe.Skills)
                        {
                            <li class="about-skill-chip">@skill</li>
                        }
                    </ul>
                </div>
            </div>

            <blockquote class="about-quote">@aboutMe.DetailOrQuote</blockquote>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required HttpClient Http { get; set; }

    [Parameter, EditorRequired]
    public required HeroImageService HeroImageService { get; set; }

    private AboutMe? aboutMe;
    private HeroImage? hero;

    protected override async Task OnInitializedAsync()
    {
        aboutMe = await Http.GetFromJsonAsync<AboutMe>("sample-data/aboutme.json");
        hero = await HeroImageService.GetHeroAsync(img => img.Name is "about");
    }
}
