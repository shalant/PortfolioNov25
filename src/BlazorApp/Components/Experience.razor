<section class="experience-section" id="experience">
    <div class="experience-container">

        <div class="experience-header">
            <span class="section-eyebrow">// experience</span>
            <h2 class="experience-heading">Where I've Worked</h2>
        </div>

        @if (experiences is null)
        {
            <p style="color: rgba(238,242,247,0.4); font-family: 'Courier New', monospace; font-size: 0.85rem;">
                loading...
            </p>
        }
        else
        {
            <div class="experience-layout">

                <div class="experience-list" role="tablist">
                    @for (int i = 0; i < experiences.Count; i++)
                    {
                        var idx = i;
                        var exp = experiences[i];
                        <button class="experience-list__item @(idx == _activeIndex ? "active" : "")"
                                role="tab"
                                aria-selected="@(idx == _activeIndex)"
                                @onclick="() => SetActive(idx)">
                            <span class="experience-list__num">@((idx + 1).ToString("D2"))</span>
                            <span class="experience-list__logo-wrap">
                                <img src="@exp.Image" alt="" class="experience-list__logo" />
                            </span>
                            <span class="experience-list__title">@exp.Title</span>
                        </button>
                    }
                </div>

                <div class="experience-detail" role="tabpanel" @key="_activeIndex">
                    @{
                        var active = experiences[_activeIndex];
                        var numStr = (_activeIndex + 1).ToString("D2");
                    }
                    <div class="experience-detail__num-bg" aria-hidden="true">@numStr</div>

                    <div class="experience-detail__logo-wrap">
                        <img src="@active.Image" alt="@active.Title" class="experience-detail__logo" />
                    </div>

                    <h3 class="experience-detail__title">@active.Title</h3>
                    <div class="experience-detail__divider"></div>

                    <ul class="experience-detail__bullets">
                        @foreach (var bullet in active.Bulletpoints)
                        {
                            <li>@bullet</li>
                        }
                    </ul>

                    <div class="experience-detail__footer">
                        <div class="experience-detail__chips">
                            @foreach (var chip in active.Icons.Split(","))
                            {
                                <TechChip Name="@chip.Trim()" />
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(active.Url) && active.Url.StartsWith("http"))
                        {
                            <a href="@active.Url"
                               target="_blank" rel="noopener noreferrer"
                               class="experience-detail__link">
                                visit site ↗
                            </a>
                        }
                    </div>
                </div>

            </div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public required HttpClient Http { get; set; }

    [Parameter, EditorRequired]
    public required HeroImageService HeroImageService { get; set; }

    private List<ExperienceModel>? experiences;
    private int _activeIndex = 0;

    protected override async Task OnInitializedAsync()
    {
        experiences = await Http.GetFromJsonAsync<List<ExperienceModel>>("sample-data/experience.json");
    }

    private void SetActive(int index) => _activeIndex = index;
}
