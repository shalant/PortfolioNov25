<section class="skills-section reveal-on-scroll" id="technicalskills">
    <div class="skills-container">

        <div class="skills-header">
            <span class="section-eyebrow">// technical skills</span>
            <h2 class="skills-heading">What I Build With</h2>
        </div>

        <div class="skills-grid">

            <div class="skills-category">
                <span class="skills-category__label">Languages</span>
                <div class="skills-category__chips reveal-on-scroll">
                    <TechChip Name="C#" />
                    <TechChip Name="JavaScript" />
                    <TechChip Name="TypeScript" />
                    <TechChip Name="SQL" />
                    <TechChip Name="HTML / CSS" />
                </div>
            </div>

            <div class="skills-category">
                <span class="skills-category__label">Frameworks &amp; UI</span>
                <div class="skills-category__chips reveal-on-scroll">
                    <TechChip Name=".NET 10" />
                    <TechChip Name="Blazor" />
                    <TechChip Name="Angular" />
                    <TechChip Name="React" />
                    <TechChip Name="Node.js" />
                    <TechChip Name="MudBlazor" />
                    <TechChip Name="Bootstrap" />
                </div>
            </div>

            <div class="skills-category">
                <span class="skills-category__label">Cloud &amp; Infrastructure</span>
                <div class="skills-category__chips reveal-on-scroll">
                    <TechChip Name="Azure" />
                    <TechChip Name="AWS" />
                    <TechChip Name="Docker" />
                    <TechChip Name="Linux" />
                    <TechChip Name="Github Actions" />
                    <TechChip Name="Digital Ocean" />
                    <TechChip Name="SQL Server" />
                </div>
            </div>

            <div class="skills-category">
                <span class="skills-category__label">Tooling &amp; Design</span>
                <div class="skills-category__chips reveal-on-scroll">
                    <TechChip Name="Figma" />
                    <TechChip Name="GitLab" />
                    <TechChip Name="Entity Framework" />
                    <TechChip Name="Syncfusion" />
                    <TechChip Name="DevExpress" />
                </div>
            </div>

        </div>

        <div class="skills-github">
            <span class="section-eyebrow">// github activity</span>
            <div class="skills-github__frames">
                <div class="skills-github__card">
                    <iframe src="https://github-readme-stats.vercel.app/api?username=shalant&show_icons=true&theme=radical&bg_color=060e1a&border_color=1abc9c22&title_color=1abc9c&icon_color=1abc9c&text_color=eef2f7aa"
                            frameborder="0" scrolling="no" width="400" height="165" title="GitHub Stats"
                            loading="lazy"></iframe>
                </div>
                <div class="skills-github__card">
                    <iframe src="https://github-readme-stats.vercel.app/api/top-langs/?username=shalant&theme=radical&bg_color=060e1a&border_color=1abc9c22&title_color=1abc9c&text_color=eef2f7aa&layout=compact"
                            frameborder="0" scrolling="no" width="340" height="165" title="Top Languages"
                            loading="lazy"></iframe>
                </div>
            </div>
        </div>

    </div>
</section>

