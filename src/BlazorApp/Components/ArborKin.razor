<section class="arborkin-section" id="arborkin">
    <div class="arborkin-container">

        <div class="arborkin-header">
            <div class="arborkin-header__text">
                <span class="section-eyebrow">// case study</span>
                <h2 class="arborkin-title">ArborKin</h2>
                <p class="arborkin-tagline">
                    A private, multi-user family tree app — built solo, shipped to Azure, used by real people.
                    Full stack from data model to layout algorithm to auth system.
                </p>
                <div class="arborkin-stack">
                    @foreach (var tech in _stack)
                    {
                        <span class="arborkin-chip">@tech</span>
                    }
                </div>
            </div>
            <div class="arborkin-header__links">
                <a href="https://github.com/shalant/FamilyTree"
                   target="_blank" rel="noopener noreferrer"
                   class="arborkin-gh-link">
                    View on GitHub ↗
                </a>
                <span class="arborkin-live-badge">Live · invite-only</span>
            </div>
        </div>

        <figure class="arborkin-hero-shot">
            <img src="images/arborkin/familytree-hero.png"
                 alt="ArborKin tree canvas — focus person centered, ancestors above, descendants below"
                 loading="lazy" />
            <figcaption>
                The tree canvas. Focus person is centered; ancestors flow upward, descendants downward.
                The Y-axis is a real birth-year timeline — generation gaps render proportionally.
            </figcaption>
        </figure>

        <div class="arborkin-problems-label">
            <span class="section-eyebrow">// hard problems solved</span>
        </div>

        <div class="arborkin-problems">
            <div class="arborkin-problem-card">
                <span class="arborkin-problem-card__num">01</span>
                <h3>JS-Free Tree Layout</h3>
                <p>
                    Every node's pixel position is computed in C# before anything renders.
                    No <code>getBoundingClientRect</code>, no post-render step, no flicker.
                    The SVG connector layer uses the same pre-calculated coordinates —
                    always aligned on first paint.
                </p>
            </div>
            <div class="arborkin-problem-card">
                <span class="arborkin-problem-card__num">02</span>
                <h3>Blazor Upload Latency</h3>
                <p>
                    Photos were taking <strong>five minutes</strong>. Root cause: every byte
                    travels over SignalR to the server before reaching Azure Blob Storage.
                    Fix: Canvas API compression in the browser first — 12 MB phone photo
                    becomes ~400 KB before Blazor ever touches it. Minutes → seconds.
                </p>
            </div>
            <div class="arborkin-problem-card">
                <span class="arborkin-problem-card__num">03</span>
                <h3>Drag State Ownership</h3>
                <p>
                    Blazor re-renders reset dragged element positions. Solution: JS owns the
                    gesture (<code>mousemove</code> updates <code>style.left/top</code> directly),
                    and on <code>mouseup</code> calls a <code>[JSInvokable]</code> method.
                    Blazor stores, persists to localStorage, restores on next mount. No conflicts.
                </p>
            </div>
        </div>

        <div class="arborkin-shots">
            <figure class="arborkin-shot">
                <img src="images/arborkin/familytree-detaildrawer.png"
                     alt="Person detail drawer"
                     loading="lazy" />
                <figcaption>Detail drawer — vitals, bio &amp; photos without leaving the canvas</figcaption>
            </figure>
            <figure class="arborkin-shot">
                <img src="images/arborkin/familytree-hero__dark.png"
                     alt="Tree canvas in dark mode"
                     loading="lazy" />
                <figcaption>Dark mode — single CSS variable swap, persisted to localStorage</figcaption>
            </figure>
            <figure class="arborkin-shot">
                <img src="images/arborkin/familytree-edit.png"
                     alt="Edit person form"
                     loading="lazy" />
                <figcaption>Edit form — relationship pickers with full autocomplete</figcaption>
            </figure>
        </div>

        <div class="arborkin-stats">
            @foreach (var stat in _stats)
            {
                <div class="arborkin-stat">
                    <span class="arborkin-stat__value">@stat.Value</span>
                    <span class="arborkin-stat__label">@stat.Label</span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private readonly string[] _stack = [
        ".NET 10", "C# 13", "Blazor Server", "EF Core",
        "MudBlazor", "Azure App Service", "Azure SQL", "Blob Storage"
    ];

    private record Stat(string Value, string Label);

    private readonly Stat[] _stats = [
        new("~8k",   "lines of C#"),
        new("12",    "EF migrations"),
        new("11",    "xUnit tests"),
        new("3",     "Azure services"),
        new("solo",  "full-stack build"),
    ];
}
