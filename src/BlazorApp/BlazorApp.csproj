<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a93527af-1ac0-446a-b298-ce2c65e570a0</UserSecretsId>
    <!-- No culture-specific formatting in this app (dates use explicit format strings) —
         invariant mode skips downloading full ICU globalization data, cutting WASM payload. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="8.15.0" />
  </ItemGroup>

  <!-- Serve the Angular archive as plain static files; exclude from fingerprinting/compression -->
  <ItemGroup>
    <Content Update="wwwroot/archive/**/*">
      <Fingerprint>false</Fingerprint>
      <Compress>false</Compress>
    </Content>
  </ItemGroup>

</Project>
