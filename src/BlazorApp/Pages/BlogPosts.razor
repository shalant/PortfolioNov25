@page "/blog"
@using System.Text.Json
@using System.Text.Json.Serialization
@inject HttpClient Http

<PageTitle>Blog — Doug Rosenberg Dev</PageTitle>

<div class="dr-theme-scope">
<Header />

<section class="subpage-hero" id="blog-hero">
    <div class="subpage-hero__grid-bg"></div>
    <div class="subpage-hero__content">
        <div class="subpage-hero__text">
            <span class="section-eyebrow">// blog</span>
            <h1 class="subpage-hero__title">Thoughts & Insights</h1>
            <p class="subpage-hero__sub">On development, design, and building things</p>
        </div>
    </div>
</section>

<section class="blog-posts-section">
    <div class="blog-container">
        <div class="blog-header">
            <h2>Latest Posts</h2>
            <a href="/blog/archive" class="blog-archive-link">View Archive →</a>
        </div>

        <div class="blog-search-section">
            <input type="text"
                   placeholder="Search posts..."
                   @bind="SearchQuery"
                   class="blog-search-input" />

            @if (GetAllTags().Any())
            {
                <div class="blog-tags-filter">
                    <button class="blog-tag @(SelectedTag == null ? "active" : "")"
                            @onclick="() => SelectedTag = null">
                        All
                    </button>
                    @foreach (var tag in GetAllTags())
                    {
                        <button class="blog-tag @(SelectedTag == tag ? "active" : "")"
                                @onclick="() => SelectedTag = tag">
                            @tag
                        </button>
                    }
                </div>
            }
        </div>

        @if (Posts == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (!Posts.Any())
        {
            <div class="alert alert-info">No blog posts yet. Check back soon!</div>
        }
        else
        {
            var featured = Posts.Where(p => p.Featured).OrderByDescending(p => p.Date).ToList();
            @if (featured.Any() && string.IsNullOrWhiteSpace(SearchQuery) && SelectedTag == null)
            {
                <div class="featured-posts-section">
                    <div class="featured-posts-header">✨ Featured</div>
                    <div class="featured-posts-grid">
                        @foreach (var post in featured.Take(3))
                        {
                            <article class="featured-post-card" @onclick="() => SelectPost(post)">
                                <div class="featured-post-badge">Featured</div>
                                <h3 class="featured-post-title">@post.Title</h3>
                                <div class="featured-post-meta">
                                    <span>@DateTime.Parse(post.Date).ToString("MMM d, yyyy")</span>
                                    <span>@post.ReadingTimeMinutes min read</span>
                                </div>
                                <p class="featured-post-excerpt">@post.Excerpt</p>
                            </article>
                        }
                    </div>
                </div>
            }

            var filtered = GetFilteredPosts();
            @if (!filtered.Any())
            {
                <div class="alert alert-info">No posts match your search.</div>
            }
            else
            {
                <div class="blog-grid">
                    @foreach (var post in filtered.OrderByDescending(p => p.Date))
                {
                    <article class="blog-post-card" @onclick="() => SelectPost(post)">
                        <div class="blog-post-card__content">
                            <h3 class="blog-post-card__title">@post.Title</h3>
                            <div class="blog-post-card__meta">
                                <time class="blog-post-card__date">@DateTime.Parse(post.Date).ToString("MMMM d, yyyy")</time>
                                <span class="blog-post-card__reading-time">@post.ReadingTimeMinutes min read</span>
                            </div>
                            <p class="blog-post-card__excerpt">@post.Excerpt</p>
                            @if (post.Tags.Any())
                            {
                                <div class="blog-post-card__tags">
                                    @foreach (var tag in post.Tags)
                                    {
                                        <span class="blog-post-card__tag">@tag</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="blog-post-card__arrow">→</div>
                    </article>
                    }
                </div>
            }
        }

        @if (SelectedPost != null)
        {
            <div class="modal-overlay" @onclick="DeselectPost">
                <div class="modal-dialog" @onclick:stopPropagation="true">
                    <button class="modal-close" @onclick="DeselectPost">✕</button>
                    <article class="blog-post-detail">
                        <header class="blog-post-detail__header">
                            <div class="blog-post-detail__title-row">
                                <div>
                                    <h1>@SelectedPost.Title</h1>
                                    <div class="blog-post-detail__meta">
                                        <time>@DateTime.Parse(SelectedPost.Date).ToString("MMMM d, yyyy")</time>
                                        <span class="blog-post-detail__reading-time">@SelectedPost.ReadingTimeMinutes min read</span>
                                    </div>
                                </div>
                                <div class="blog-post-detail__share">
                                    <a href="@GetTwitterShareUrl()" target="_blank" rel="noopener" class="share-btn twitter" title="Share on Twitter">
                                        𝕏
                                    </a>
                                    <a href="@GetLinkedInShareUrl()" target="_blank" rel="noopener" class="share-btn linkedin" title="Share on LinkedIn">
                                        in
                                    </a>
                                </div>
                            </div>
                        </header>
                        @if (SelectedPost.Tags?.Count > 0)
                        {
                            <div class="blog-post-detail__tags">
                                @foreach (var tag in SelectedPost.Tags)
                                {
                                    <span class="blog-post-detail__tag" @onclick="() => { SelectedTag = tag; DeselectPost(); }">@tag</span>
                                }
                            </div>
                        }

                        @{
                            var headings = ExtractHeadings(SelectedPost.Content);
                            if (headings.Any())
                            {
                                <nav class="blog-post-detail__toc">
                                    <div class="toc-title">Table of Contents</div>
                                    <ul class="toc-list">
                                        @foreach (var heading in headings)
                                        {
                                            <li class="toc-item" style="margin-left: @((heading.Level - 2) * 1.5)rem">
                                                <a href="#@heading.Id" class="toc-link">@heading.Text</a>
                                            </li>
                                        }
                                    </ul>
                                </nav>
                            }
                        }

                        @if (SelectedPost.Images?.Count > 0)
                        {
                            <div class="blog-post-detail__images">
                                @foreach (var image in SelectedPost.Images)
                                {
                                    <img src="@image" alt="@SelectedPost.Title" class="blog-post-detail__image" />
                                }
                            </div>
                        }
                        <div class="blog-post-detail__content">
                            @((MarkupString)AddHeadingIds(SelectedPost.Content))
                        </div>

                        @{
                            var relatedPosts = GetRelatedPosts(SelectedPost).Take(3).ToList();
                            if (relatedPosts.Any())
                            {
                                <div class="blog-post-detail__related">
                                    <h3>Related Posts</h3>
                                    <ul class="related-posts-list">
                                        @foreach (var related in relatedPosts)
                                        {
                                            <li class="related-post-item">
                                                <a href="javascript:void(0)" @onclick="() => SelectPost(related)" class="related-post-link">
                                                    @related.Title
                                                </a>
                                                <span class="related-post-meta">@DateTime.Parse(related.Date).ToString("MMM d, yyyy")</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                    </article>
                </div>
            </div>
        }
    </div>
</section>

<Footer />
</div>

@code {
    private List<BlogPost>? Posts;
    private BlogPost? SelectedPost;
    private string SearchQuery = string.Empty;
    private string? SelectedTag = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Posts = await Http.GetFromJsonAsync<List<BlogPost>>("sample-data/blog-posts.json") ?? new List<BlogPost>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading blog posts: {ex.Message}");
            Posts = new List<BlogPost>();
        }
    }

    private void SelectPost(BlogPost post)
    {
        SelectedPost = post;
    }

    private void DeselectPost()
    {
        SelectedPost = null;
    }

    private List<BlogPost> GetFilteredPosts()
    {
        var filtered = Posts ?? new List<BlogPost>();

        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            var query = SearchQuery.ToLower();
            filtered = filtered.Where(p =>
                p.Title.ToLower().Contains(query) ||
                p.Excerpt.ToLower().Contains(query)
            ).ToList();
        }

        if (!string.IsNullOrWhiteSpace(SelectedTag))
        {
            filtered = filtered.Where(p => p.Tags.Contains(SelectedTag)).ToList();
        }

        return filtered;
    }

    private List<string> GetAllTags()
    {
        return Posts?
            .SelectMany(p => p.Tags)
            .Distinct()
            .OrderBy(t => t)
            .ToList() ?? new List<string>();
    }

    private List<BlogPost> GetRelatedPosts(BlogPost currentPost)
    {
        return (Posts ?? new List<BlogPost>())
            .Where(p => p.Id != currentPost.Id)
            .OrderByDescending(p =>
            {
                var score = 0;
                score += p.Tags.Count(t => currentPost.Tags.Contains(t)) * 3;
                var titleWords = currentPost.Title.Split(' ', System.StringSplitOptions.RemoveEmptyEntries);
                score += titleWords.Count(w => p.Title.Contains(w, System.StringComparison.OrdinalIgnoreCase));
                return score;
            })
            .Where(p => p.Tags.Any(t => currentPost.Tags.Contains(t)) ||
                       currentPost.Title.Split(' ').Any(w => p.Title.Contains(w, System.StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }

    private string GetTwitterShareUrl()
    {
        var url = $"https://dougrosenbergdev.com/blog";
        var text = Uri.EscapeDataString($"{SelectedPost?.Title} - Doug Rosenberg Dev");
        return $"https://twitter.com/intent/tweet?url={Uri.EscapeDataString(url)}&text={text}&via=dougrosenbergdev";
    }

    private string GetLinkedInShareUrl()
    {
        var url = Uri.EscapeDataString("https://dougrosenbergdev.com/blog");
        return $"https://www.linkedin.com/sharing/share-offsite/?url={url}";
    }

    private List<HeadingInfo> ExtractHeadings(string html)
    {
        var headings = new List<HeadingInfo>();
        var regex = new System.Text.RegularExpressions.Regex(@"<(h[2-3])(?:\s+id=[""']([^""']*)[""'])?[^>]*>([^<]+)</h[2-3]>", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var matches = regex.Matches(html);

        foreach (System.Text.RegularExpressions.Match match in matches)
        {
            var tag = match.Groups[1].Value.ToLower();
            var level = tag == "h2" ? 2 : 3;
            var id = match.Groups[2].Value;
            var text = match.Groups[3].Value.Trim();

            if (string.IsNullOrEmpty(id))
            {
                id = System.Text.RegularExpressions.Regex.Replace(text.ToLower(), @"[^a-z0-9]+", "-").Trim('-');
            }

            headings.Add(new HeadingInfo { Level = level, Text = text, Id = id });
        }

        return headings;
    }

    private string AddHeadingIds(string html)
    {
        var regex = new System.Text.RegularExpressions.Regex(@"<(h[2-3])(?:\s+id=[""']([^""']*)[""'])?([^>]*)>([^<]+)(</h[2-3]>)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return regex.Replace(html, match =>
        {
            var tag = match.Groups[1].Value;
            var existingId = match.Groups[2].Value;
            var attrs = match.Groups[3].Value;
            var text = match.Groups[4].Value;
            var closeTag = match.Groups[5].Value;

            if (string.IsNullOrEmpty(existingId))
            {
                existingId = System.Text.RegularExpressions.Regex.Replace(text.ToLower(), @"[^a-z0-9]+", "-").Trim('-');
            }

            return $"<{tag} id=\"{existingId}\"{attrs}>{text}{closeTag}";
        });
    }

    private class HeadingInfo
    {
        public int Level { get; set; }
        public string Text { get; set; } = string.Empty;
        public string Id { get; set; } = string.Empty;
    }

    private class BlogPost
    {
        [JsonPropertyName("id")]
        public string Id { get; set; } = string.Empty;

        [JsonPropertyName("title")]
        public string Title { get; set; } = string.Empty;

        [JsonPropertyName("date")]
        public string Date { get; set; } = string.Empty;

        [JsonPropertyName("excerpt")]
        public string Excerpt { get; set; } = string.Empty;

        [JsonPropertyName("content")]
        public string Content { get; set; } = string.Empty;

        [JsonPropertyName("images")]
        public List<string> Images { get; set; } = new();

        [JsonPropertyName("readingTimeMinutes")]
        public int ReadingTimeMinutes { get; set; }

        [JsonPropertyName("tags")]
        public List<string> Tags { get; set; } = new();

        [JsonPropertyName("featured")]
        public bool Featured { get; set; }
    }
}

