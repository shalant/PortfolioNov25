@page "/blog"
@inject HttpClient Http

<PageTitle>Blog — Douglas Rosenberg | Full-Stack .NET Developer</PageTitle>

<div class="dr-theme-scope">
<Header />

<section class="subpage-hero" id="blog-hero">
    <div class="subpage-hero__grid-bg"></div>
    <div class="subpage-hero__content">
        <div class="subpage-hero__text">
            <span class="section-eyebrow">// blog</span>
            <h1 class="subpage-hero__title">Thoughts & Insights</h1>
            <p class="subpage-hero__sub">On development, design, and building things</p>
        </div>
    </div>
</section>

<section class="blog-posts-section">
    <div class="blog-container">
        <div class="blog-header">
            <h2>Latest Posts</h2>
            <a href="/blog/archive" class="blog-archive-link">View Archive →</a>
        </div>

        <div class="blog-search-section">
            <input type="text"
                   placeholder="Search posts..."
                   @bind="SearchQuery"
                   class="blog-search-input" />

            @if (GetAllTags().Any())
            {
                <div class="blog-tags-filter">
                    <button class="blog-tag @(SelectedTag == null ? "active" : "")"
                            @onclick="() => SelectedTag = null">
                        All
                    </button>
                    @foreach (var tag in GetAllTags())
                    {
                        <button class="blog-tag @(SelectedTag == tag ? "active" : "")"
                                @onclick="() => SelectedTag = tag">
                            @tag
                        </button>
                    }
                </div>
            }
        </div>

        @if (Posts == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        }
        else if (!Posts.Any())
        {
            <div class="alert alert-info">No blog posts yet. Check back soon!</div>
        }
        else
        {
            var featured = Posts.Where(p => p.Featured).OrderByDescending(p => p.Date).ToList();
            @if (featured.Any() && string.IsNullOrWhiteSpace(SearchQuery) && SelectedTag == null)
            {
                <div class="featured-posts-section">
                    <div class="featured-posts-header">✨ Featured</div>
                    <div class="featured-posts-grid">
                        @foreach (var post in featured.Take(3))
                        {
                            <a class="featured-post-card" href="@($"/blog/{post.Id}")">
                                <div class="featured-post-badge">Featured</div>
                                <h3 class="featured-post-title">@post.Title</h3>
                                <div class="featured-post-meta">
                                    <span>@DateTime.Parse(post.Date).ToString("MMM d, yyyy")</span>
                                    <span>@post.ReadingTimeMinutes min read</span>
                                </div>
                                <p class="featured-post-excerpt">@post.Excerpt</p>
                            </a>
                        }
                    </div>
                </div>
            }

            var filtered = GetFilteredPosts();
            @if (!filtered.Any())
            {
                <div class="alert alert-info">No posts match your search.</div>
            }
            else
            {
                <div class="blog-grid">
                    @foreach (var post in filtered.OrderByDescending(p => p.Date))
                {
                    <a class="blog-post-card" href="@($"/blog/{post.Id}")">
                        <div class="blog-post-card__content">
                            <h3 class="blog-post-card__title">@post.Title</h3>
                            <div class="blog-post-card__meta">
                                <time class="blog-post-card__date">@DateTime.Parse(post.Date).ToString("MMMM d, yyyy")</time>
                                <span class="blog-post-card__reading-time">@post.ReadingTimeMinutes min read</span>
                            </div>
                            <p class="blog-post-card__excerpt">@post.Excerpt</p>
                            @if (post.Tags.Any())
                            {
                                <div class="blog-post-card__tags">
                                    @foreach (var tag in post.Tags)
                                    {
                                        <span class="blog-post-card__tag">@tag</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="blog-post-card__arrow">→</div>
                    </a>
                }
                </div>
            }
        }
    </div>
</section>

<Footer />
</div>

@code {
    private List<BlogPost>? Posts;
    private string SearchQuery = string.Empty;
    private string? SelectedTag = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Posts = await Http.GetFromJsonAsync<List<BlogPost>>("sample-data/blog-posts.json") ?? new List<BlogPost>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading blog posts: {ex.Message}");
            Posts = new List<BlogPost>();
        }
    }

    private List<BlogPost> GetFilteredPosts()
    {
        var filtered = Posts ?? new List<BlogPost>();

        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            var query = SearchQuery.ToLower();
            filtered = filtered.Where(p =>
                p.Title.ToLower().Contains(query) ||
                p.Excerpt.ToLower().Contains(query)
            ).ToList();
        }

        if (!string.IsNullOrWhiteSpace(SelectedTag))
        {
            filtered = filtered.Where(p => p.Tags.Contains(SelectedTag)).ToList();
        }

        return filtered;
    }

    private List<string> GetAllTags()
    {
        return Posts?
            .SelectMany(p => p.Tags)
            .Distinct()
            .OrderBy(t => t)
            .ToList() ?? new List<string>();
    }
}

<style>
    .blog-posts-section {
        padding: 4rem 0;
        background: url('/images/artDecoBackground1.webp') center / cover no-repeat fixed;
        position: relative;
        overflow: hidden;
    }

    .blog-posts-section::before {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(var(--surface-rgb), 0.65);
        pointer-events: none;
        z-index: 1;
    }

    .blog-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 1rem;
        position: relative;
        z-index: 2;
    }

    .blog-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(var(--accent-rgb), 0.1);
    }

    .blog-header h2 {
        margin: 0;
        font-size: 1.5rem;
        color: var(--text);
    }

    .blog-archive-link {
        color: var(--accent);
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .blog-archive-link:hover {
        color: var(--text);
        transform: translateX(4px);
    }

    .featured-posts-section {
        margin-bottom: 3rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid rgba(var(--accent-rgb), 0.1);
    }

    .featured-posts-header {
        font-size: 0.9rem;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
        margin-bottom: 1.5rem;
    }

    .featured-posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .featured-post-card {
        display: block;
        position: relative;
        padding: 2rem;
        background: linear-gradient(135deg, rgba(var(--accent-rgb), 0.15) 0%, rgba(var(--accent-rgb), 0.05) 100%);
        border: 2px solid rgba(var(--accent-rgb), 0.3);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .featured-post-card:hover {
        background: linear-gradient(135deg, rgba(var(--accent-rgb), 0.25) 0%, rgba(var(--accent-rgb), 0.1) 100%);
        border-color: var(--accent);
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(var(--accent-rgb), 0.2);
    }

    .featured-post-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: var(--accent);
        color: var(--bg);
        padding: 0.35rem 0.75rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .featured-post-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text);
        margin: 0 0 0.75rem 0;
        line-height: 1.3;
    }

    .featured-post-meta {
        display: flex;
        gap: 1rem;
        font-size: 0.85rem;
        color: rgba(var(--text-rgb), 0.6);
        margin-bottom: 1rem;
    }

    .featured-post-excerpt {
        font-size: 0.9rem;
        color: rgba(var(--text-rgb), 0.7);
        line-height: 1.5;
        margin: 0;
    }

    .blog-search-section {
        margin-bottom: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .blog-search-input {
        width: 100%;
        padding: 0.75rem 1rem;
        background: rgba(var(--text-rgb), 0.05);
        border: 1px solid rgba(var(--accent-rgb), 0.2);
        border-radius: 8px;
        color: var(--text);
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

    .blog-search-input:focus {
        outline: none;
        background: rgba(var(--text-rgb), 0.08);
        border-color: rgba(var(--accent-rgb), 0.5);
        box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.1);
    }

    .blog-search-input::placeholder {
        color: rgba(var(--text-rgb), 0.4);
    }

    .blog-tags-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .blog-tag {
        padding: 0.5rem 1rem;
        background: rgba(var(--accent-rgb), 0.1);
        border: 1px solid rgba(var(--accent-rgb), 0.3);
        border-radius: 20px;
        color: var(--accent);
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

    .blog-tag:hover {
        background: rgba(var(--accent-rgb), 0.2);
        border-color: rgba(var(--accent-rgb), 0.5);
    }

    .blog-tag.active {
        background: var(--accent);
        color: var(--bg);
        border-color: var(--accent);
    }

    .blog-post-card__tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .blog-post-card__tag {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: rgba(var(--accent-rgb), 0.15);
        color: var(--accent);
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .blog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
    }

    .blog-post-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 2rem;
        background: rgba(var(--text-rgb), 0.05);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(var(--accent-rgb), 0.25);
    }

    .blog-post-card:hover {
        transform: translateY(-4px);
        background: rgba(var(--text-rgb), 0.08);
        box-shadow: 0 12px 40px rgba(var(--accent-rgb), 0.15);
        border-color: var(--accent);
    }

    .blog-post-card__content {
        flex: 1;
    }

    .blog-post-card__title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text);
        margin: 0 0 0.5rem 0;
        line-height: 1.4;
    }

    .blog-post-card__meta {
        display: flex;
        gap: 1rem;
        align-items: center;
        margin-bottom: 1rem;
    }

    .blog-post-card__date {
        font-size: 0.8rem;
        color: rgba(var(--text-rgb), 0.5);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .blog-post-card__reading-time {
        font-size: 0.8rem;
        color: rgba(var(--accent-rgb), 0.8);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .blog-post-card__excerpt {
        font-size: 0.95rem;
        color: rgba(var(--text-rgb), 0.7);
        line-height: 1.6;
        margin: 0;
    }

    .blog-post-card__arrow {
        margin-top: 1.5rem;
        font-size: 1.5rem;
        color: var(--accent);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .blog-post-card:hover .blog-post-card__arrow {
        opacity: 1;
    }

    @@media (max-width: 768px) {
        /* fixed backgrounds force a repaint on every scroll frame on iOS Safari — drop
           the parallax attachment on mobile, keep it on desktop */
        .blog-posts-section {
            background-attachment: scroll;
        }

        .blog-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Excerpts are real body copy (not captions/labels), so match the
       Phase A homepage pattern: 0.7 alpha reads fine dimmed on a
       near-black hero but fails to feel comfortable once inverted onto
       cream. Bumped to 0.85 for light mode only. */
    html[data-theme="light"] .dr-theme-scope .featured-post-excerpt,
    html[data-theme="light"] .dr-theme-scope .blog-post-card__excerpt {
        color: rgba(var(--text-rgb), 0.85);
    }
</style>
