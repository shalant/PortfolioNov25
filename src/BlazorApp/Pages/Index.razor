@page "/"

@inject HttpClient Http
@inject HeroImageService HeroImageService
@inject SitePropertiesService SitePropertiesService
@inject IJSRuntime JS

<PageTitle>Douglas Rosenberg — Full-Stack .NET Developer | Blazor & ERP Systems</PageTitle>

<div class="dr-theme-scope">
    <Header />
    <VerticalSectionNav />
    <Home HeroImageService=@HeroImageService SitePropertiesService=@SitePropertiesService />
    <About Http=@Http />
    <Experience Http=@Http HeroImageService=@HeroImageService />
    <TechnicalSkills />
    <Casual Http="@Http" HeroImageService="@HeroImageService" />
    <Music Http="@Http" HeroImageService="@HeroImageService" />

    <Contact />

    <Footer PrimaryColor="#4E567E" SecondaryColor="#D2F1E4" />
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("DrScrollReveal.init");
        }
    }
}