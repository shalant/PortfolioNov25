@page "/"

@inject HttpClient Http
@inject HeroImageService HeroImageService

<PageTitle>Doug Rosenberg Dev</PageTitle>

<Header />
<Home Http=@Http HeroImageService=@HeroImageService />
<About Http=@Http />
<Experience Http=@Http HeroImageService=@HeroImageService />
<TechnicalSkills />
<Casual Http="@Http" HeroImageService="@HeroImageService" />
<Music Http="@Http" HeroImageService="@HeroImageService" />

<Contact />

<Footer Http=@Http PrimaryColor="#4E567E" SecondaryColor="#D2F1E4" />

<script suppress-error="BL9992">
    (function () {
        function initScrollReveal() {
            var targets = document.querySelectorAll('.reveal-on-scroll:not([data-reveal-bound])');
            if (!targets.length) return;

            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });

            targets.forEach(function (el) {
                el.setAttribute('data-reveal-bound', 'true');
                observer.observe(el);
            });
        }

        // sections render statically on first paint, but retry once for
        // safety against slower async-loaded content (Experience)
        setTimeout(initScrollReveal, 300);
        setTimeout(initScrollReveal, 800);
    })();
</script>