@page "/webdesign"
@inject HttpClient Http

<PageTitle>Web Design — Doug Rosenberg Dev</PageTitle>

<div class="dr-theme-scope">
<Header />

@if (webDesign is not null)
{
    var marqueeImages = webDesign.Projects.SelectMany(p => p.Images).ToList();

    <section class="wd2-hero">
        <div class="wd2-hero__marquee wd2-hero__marquee--back">
            <div class="wd2-hero__track wd2-hero__track--slow">
                @foreach (var src in marqueeImages.Concat(marqueeImages))
                {
                    <img src="@src" alt="" loading="eager" />
                }
            </div>
        </div>
        <div class="wd2-hero__marquee wd2-hero__marquee--front">
            <div class="wd2-hero__track wd2-hero__track--fast wd2-hero__track--reverse">
                @foreach (var src in marqueeImages.Concat(marqueeImages))
                {
                    <img src="@src" alt="" loading="eager" />
                }
            </div>
        </div>
        <div class="wd2-hero__scrim"></div>
        <div class="wd2-hero__glass">
            <span class="section-eyebrow">// web design</span>
            <h1 class="wd2-hero__title">@webDesign.Headline</h1>
            <p class="wd2-hero__sub">@webDesign.Subheadline</p>
        </div>
    </section>

    <section class="webdesign-projects">
        <div class="webdesign-projects__container">
            <span class="section-eyebrow">// selected work</span>
            <h2 class="webdesign-projects__heading">Live Sites</h2>

            <div class="wd-projects-grid">

                @foreach (var project in webDesign.Projects)
                {
                    <a href="/webdesign/@project.Slug" class="wd-project">
                        <ProjectMediaFrame
                            Alt="@($"{project.Name} website")"
                            Images="@project.Images" />
                        <div class="wd-project__meta">
                            <span class="wd-project__num">@project.Number</span>
                            <span class="about-skill-chip">@project.Platform</span>
                            @if (!string.IsNullOrEmpty(project.Status))
                            {
                                <span class="wd-project__wip">@project.Status</span>
                            }
                        </div>
                        <h3 class="wd-project__name">@project.Name</h3>
                        <p class="wd-project__industry">@project.Industry</p>
                        <ul class="wd-project__bullets">
                            @foreach (var bullet in project.Bullets)
                            {
                                <li>@bullet</li>
                            }
                        </ul>
                        <span class="wd-project__cta">view case study →</span>
                    </a>
                }

                <article class="wd-project wd-project--static">
                    <div class="wd-project__meta">
                        <span class="wd-project__num">05</span>
                        <span class="about-skill-chip">Blazor Server</span>
                        <span class="wd-project__wip">in progress</span>
                    </div>
                    <h3 class="wd-project__name">coming soon: BizMachina</h3>
                    <p class="wd-project__industry">Demo business ERP system</p>
                    <ul class="wd-project__bullets">
                        <li>Custom Blazor Server, DB, cheap deployment, AI document consumption</li>
                    </ul>
                </article>

                <a href="https://haxbyte.com" target="_blank" rel="noopener noreferrer" class="wd-project wd-project--haxbyte">
                    <div class="wd-project__meta">
                        <span class="about-skill-chip">the brand behind this work</span>
                    </div>
                    <h3 class="wd-project__name">Haxbyte</h3>
                    <p class="wd-project__industry">Web design &amp; consulting studio</p>
                    <p class="wd-project__haxbyte-text">This work is delivered under Haxbyte — a dedicated studio, not a one-off side gig.</p>
                    <span class="wd-project__cta">visit haxbyte.com →</span>
                </a>

            </div>
        </div>
    </section>

    <section class="wd2-tools">
        <div class="wd2-tools__container">
            <span class="section-eyebrow">// toolkit</span>
            <div class="wd2-tools__chips">
                @foreach (var tool in webDesign.Tools)
                {
                    <TechChip Name="@tool" />
                }
            </div>
        </div>
    </section>
}

<Footer />
</div>

@code {
    private WebDesignModel? webDesign;

    protected override async Task OnInitializedAsync()
    {
        webDesign = await Http.GetFromJsonAsync<WebDesignModel>("sample-data/webdesign.json");
    }
}
