@page "/webdesign"
@inject HttpClient Http

<PageTitle>Web Design — Doug Rosenberg Dev</PageTitle>

<Header />

<section class="subpage-hero" id="webdesign-hero">
    <div class="subpage-hero__grid-bg"></div>
    <div class="subpage-hero__content subpage-hero__content--centered">
        <span class="section-eyebrow">// web design</span>
        @if (webDesign is null)
        {
            <h1 class="subpage-hero__title subpage-hero__title--centered">UI/UX Design</h1>
        }
        else
        {
            <h1 class="subpage-hero__title subpage-hero__title--centered">@webDesign.Headline</h1>
            <p class="subpage-hero__sub subpage-hero__sub--centered">@webDesign.Subheadline</p>
        }
    </div>
</section>

@if (webDesign is not null)
{
    <section class="webdesign-tools">
        <div class="webdesign-tools__container">
            <span class="section-eyebrow">// toolkit</span>
            <h2 class="webdesign-tools__heading">Tools &amp; Frameworks</h2>
            @* <div class="webdesign-tools__chips">
                @foreach (var tool in webDesign.Tools)
                {
                    <span class="about-skill-chip">@tool</span>
                }
            </div> *@
            <div class="skills-category">
                <span class="skills-category__label">Frameworks &amp; UI</span>
                <div class="skills-category__chips">
                    <TechChip Name="Figma" />
                    <TechChip Name="Canva" />
                    <TechChip Name="Claude" />
                    <TechChip Name="Squarespace" />
                    <TechChip Name="Blazor" />
                    <TechChip Name="Angular" />
                    <TechChip Name="CSS / Animations" />
                    <TechChip Name="MudBlazor" />
                    <TechChip Name="Bootstrap" />
                    <TechChip Name="Syncfusion" />
                </div>
            </div>
        </div>
    </section>

    <section class="webdesign-projects">
        <div class="webdesign-projects__container">
            <span class="section-eyebrow">// selected work</span>
            <h2 class="webdesign-projects__heading">Live Sites</h2>

            <div class="wd-projects-grid">

                <article class="wd-project">
                    <div class="wd-project__frame">
                        <div class="wd-project__frame-bar">
                            <span class="wd-project__frame-dot"></span>
                            <span class="wd-project__frame-dot"></span>
                            <span class="wd-project__frame-dot"></span>
                            <span class="wd-project__frame-url">hardwareetc.net</span>
                        </div>
                        <img class="wd-project__frame-img" src="images/webdesign/hardwareetc-hero.jpg" alt="Hardware Etc LLC website" loading="lazy" />
                    </div>
                    <div class="wd-project__meta">
                        <span class="wd-project__num">01</span>
                        <span class="about-skill-chip">Squarespace</span>
                    </div>
                    <h3 class="wd-project__name">Hardware Etc LLC</h3>
                    <p class="wd-project__industry">Bulk materials supplier — multi-family residential</p>
                    <ul class="wd-project__bullets">
                        <li>Clean, professional layout communicating product quality and quick-ship availability to developer clients</li>
                        <li>Organized services and private-label cabinet catalog for high-volume procurement audiences</li>
                        <li>Responsive build optimized for both desktop spec-review and mobile field use</li>
                    </ul>
                    <div class="wd-project__links">
                        <a href="https://www.hardwareetc.net/" target="_blank" rel="noopener noreferrer" class="wd-project__link">
                            hardwareetc.net ↗
                        </a>
                    </div>
                </article>

                <article class="wd-project">
                    <div class="wd-project__frame">
                        <div class="wd-project__frame-bar">
                            <span class="wd-project__frame-dot"></span>
                            <span class="wd-project__frame-dot"></span>
                            <span class="wd-project__frame-dot"></span>
                            <span class="wd-project__frame-url">sonusconstruction.com</span>
                        </div>
                        <img class="wd-project__frame-img" src="images/webdesign/sonusconstruction-hero.jpg" alt="Sonus Construction Group website" loading="lazy" />
                    </div>
                    <div class="wd-project__meta">
                        <span class="wd-project__num">02</span>
                        <span class="about-skill-chip">Squarespace</span>
                    </div>
                    <h3 class="wd-project__name">Sonus Construction Group</h3>
                    <p class="wd-project__industry">General contractor — multi-family value-add renovation</p>
                    <ul class="wd-project__bullets">
                        <li>Minimalist editorial aesthetic with high-quality project photography driving the narrative</li>
                        <li>Structured around the "we think like owners" brand positioning, built for investor and developer audiences</li>
                        <li>Clear hierarchy across services, process, and material sourcing sections</li>
                    </ul>
                    <div class="wd-project__links">
                        <a href="https://www.sonusconstruction.com/" target="_blank" rel="noopener noreferrer" class="wd-project__link">
                            sonusconstruction.com ↗
                        </a>
                    </div>
                </article>

                <article class="wd-project">
                    <div class="wd-project__frame">
                        <div class="wd-project__frame-bar">
                            <span class="wd-project__frame-dot"></span>
                            <span class="wd-project__frame-dot"></span>
                            <span class="wd-project__frame-dot"></span>
                            <span class="wd-project__frame-url">dougrosenberg.com</span>
                        </div>
                        <img class="wd-project__frame-img" src="images/webdesign/dougrosenberg-hero.jpg" alt="dougrosenberg.com website" loading="lazy" />
                    </div>
                    <div class="wd-project__meta">
                        <span class="wd-project__num">03</span>
                        <span class="about-skill-chip">Blazor WASM</span>
                        <span class="wd-project__wip">in progress</span>
                    </div>
                    <h3 class="wd-project__name">dougrosenberg.com</h3>
                    <p class="wd-project__industry">Composer &amp; musician — personal artist site</p>
                    <ul class="wd-project__bullets">
                        <li>Custom Blazor WebAssembly build — same stack as this portfolio — replacing the previous site</li>
                        <li>Searchable sheet music library, album showcase with purchase links, and responsive photo gallery with lightbox</li>
                        <li>Six switchable color themes persisted in localStorage; scroll-spy navigation and animated counters</li>
                    </ul>
                    <div class="wd-project__links">
                        <a href="https://www.dougrosenberg.com" target="_blank" rel="noopener noreferrer" class="wd-project__link">
                            dougrosenberg.com ↗
                        </a>
                        <a href="https://github.com/shalant/newMusicWebsiteJan26" target="_blank" rel="noopener noreferrer" class="wd-project__link wd-project__link--gh">
                            github ↗
                        </a>
                    </div>
                </article>

                <article class="wd-project">
                    <div class="wd-project__frame">
                        <div class="wd-project__frame-bar">
                            <span class="wd-project__frame-dot"></span>
                            <span class="wd-project__frame-dot"></span>
                            <span class="wd-project__frame-dot"></span>
                            <span class="wd-project__frame-url">arborkin — tree canvas</span>
                        </div>
                        <img class="wd-project__frame-img" src="images/arborkin/familytree-hero.png" alt="ArborKin family tree canvas" loading="lazy" />
                    </div>
                    <div class="wd-project__meta">
                        <span class="wd-project__num">04</span>
                        <span class="about-skill-chip">Blazor Server</span>
                        <span class="wd-project__wip">live · invite-only</span>
                    </div>
                    <h3 class="wd-project__name">ArborKin</h3>
                    <p class="wd-project__industry">Private, multi-user family tree app — solo full-stack build</p>
                    <ul class="wd-project__bullets">
                        <li>JS-free tree layout — every node's pixel position computed server-side in C#, no post-render flicker</li>
                        <li>Custom drag-state ownership bridging JS gestures and Blazor persistence</li>
                        <li>~8k lines of C#, 12 EF migrations, shipped to Azure and used by real people</li>
                    </ul>
                    <div class="wd-project__links">
                        <a href="/#arborkin" class="wd-project__link">
                            full case study ↗
                        </a>
                        <a href="https://github.com/shalant/FamilyTree" target="_blank" rel="noopener noreferrer" class="wd-project__link wd-project__link--gh">
                            github ↗
                        </a>
                    </div>
                </article>

                <article class="wd-project">
                    <div class="wd-project__meta">
                        <span class="wd-project__num">05</span>
                        <span class="about-skill-chip">Blazor Server</span>
                        <span class="wd-project__wip">in progress</span>
                    </div>
                    <h3 class="wd-project__name">coming soon: BizMachina</h3>
                    <p class="wd-project__industry">Demo business ERP system</p>
                    <ul class="wd-project__bullets">
                        <li>Custom Blazor Server, DB, cheap deployment, AI document consumption</li>
                    </ul>
                    <div class="wd-project__links">
                        <a href="https://www.bizmachina.com" target="_blank" rel="noopener noreferrer" class="wd-project__link">
                            bizmachina.com ↗
                        </a>
                        <a href="https://github.com/shalant/DocIntakeERP" target="_blank" rel="noopener noreferrer" class="wd-project__link wd-project__link--gh">
                            github ↗
                        </a>
                    </div>
                </article>

            </div>
        </div>
    </section>
}

@code {
    private WebDesignModel? webDesign;

    protected override async Task OnInitializedAsync()
    {
        webDesign = await Http.GetFromJsonAsync<WebDesignModel>("sample-data/webdesign.json");
    }
}