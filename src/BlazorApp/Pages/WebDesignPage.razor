@page "/webdesign"
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Web Design — Doug Rosenberg Dev</PageTitle>

<div class="dr-theme-scope">
<Header />

@if (webDesign is not null)
{
    <section class="wd2-hero">
        <div class="wd2-hero__ring" id="wd2HeroRing"></div>
        <div class="wd2-hero__scrim"></div>
        <div class="wd2-hero__glass">
            <span class="section-eyebrow">// web design</span>
            <h1 class="wd2-hero__title">@webDesign.Headline</h1>
            <p class="wd2-hero__sub">@webDesign.Subheadline</p>
            <button type="button" class="hero-btn hero-btn--primary wd2-hero__cta"
                    onclick="gtag('event','contact_dialog_open');document.getElementById('contactDialog').showModal()">
                get in touch
            </button>
        </div>
    </section>

    <!-- Native &lt;dialog&gt; — no JS framework/interop needed, matches the plain-JS
         pattern Footer.razor already uses for its own inline onclick (2026-08-21). -->
    <dialog id="contactDialog" class="contact-dialog">
        <button type="button" class="contact-dialog__close" aria-label="Close"
                onclick="this.closest('dialog').close()">×</button>
        <h3 class="contact-dialog__title">Let's talk</h3>
        <div class="contact-dialog__options">
            <div class="contact-dialog__option">
                <h4>Quick note</h4>
                <p>Just want to say hi or ask something small.</p>
                <a class="hero-btn hero-btn--ghost"
                   onclick="gtag('event','contact_option_select',{option:'quick_note'})"
                   href="mailto:doug.rosenberg@gmail.com?subject=Hey%20Doug">send a note</a>
            </div>
            <div class="contact-dialog__option">
                <h4>Tell me about your project</h4>
                <p>Give me the details up front so I can reply with something useful.</p>
                <a class="hero-btn hero-btn--primary"
                   onclick="gtag('event','contact_option_select',{option:'project_inquiry'})"
                   href="mailto:doug.rosenberg@gmail.com?subject=Website%20project&amp;body=Hi%20Doug%2C%0D%0A%0D%0AHere%27s%20a%20bit%20about%20what%20I%27m%20thinking%3A%0D%0A%0D%0AWhat%20it%27s%20for%3A%20%0D%0ARough%20timeline%3A%20%0D%0ABudget%20range%20%28if%20you%20have%20one%20in%20mind%29%3A%20">
                    start here
                </a>
            </div>
        </div>
        <p class="contact-dialog__fallback">
            mailto link not opening? copy:
            <button type="button" class="contact-dialog__copy"
                    onclick="gtag('event','contact_email_copied');navigator.clipboard.writeText('doug.rosenberg@gmail.com').then(()=>{this.textContent='copied!';setTimeout(()=>this.textContent='doug.rosenberg@gmail.com',1500)})">
                doug.rosenberg@gmail.com
            </button>
        </p>
    </dialog>

    <section class="webdesign-projects">
        <div class="webdesign-projects__container">
            <span class="section-eyebrow">// selected work</span>
            <h2 class="webdesign-projects__heading">Live Sites</h2>

            <div class="wd-projects-grid">

                @foreach (var project in webDesign.Projects)
                {
                    <a href="/webdesign/@project.Slug" class="wd-project">
                        <ProjectMediaFrame
                            Alt="@($"{project.Name} website")"
                            Images="@project.Images" />
                        <div class="wd-project__meta">
                            <span class="wd-project__num">@project.Number</span>
                            <span class="about-skill-chip">@project.Platform</span>
                            @if (!string.IsNullOrEmpty(project.Status))
                            {
                                <span class="wd-project__wip">@project.Status</span>
                            }
                        </div>
                        <h3 class="wd-project__name">@project.Name</h3>
                        <p class="wd-project__industry">@project.Industry</p>
                        <ul class="wd-project__bullets">
                            @foreach (var bullet in project.Bullets)
                            {
                                <li>@bullet</li>
                            }
                        </ul>
                        <span class="wd-project__cta">view case study →</span>
                    </a>
                }

                <article class="wd-project wd-project--static">
                    <div class="wd-project__meta">
                        <span class="wd-project__num">09</span>
                        <span class="about-skill-chip">Blazor Server</span>
                        <span class="wd-project__wip">in progress</span>
                    </div>
                    <h3 class="wd-project__name">coming soon: BizMachina</h3>
                    <p class="wd-project__industry">Demo business ERP system</p>
                    <ul class="wd-project__bullets">
                        <li>Custom Blazor Server, DB, cheap deployment, AI document consumption</li>
                    </ul>
                </article>

            </div>
        </div>
    </section>

    <section class="wd2-tools">
        <div class="wd2-tools__container">
            <span class="section-eyebrow">// toolkit</span>
            <div class="wd2-tools__chips">
                @foreach (var tool in webDesign.Tools)
                {
                    <TechChip Name="@tool" />
                }
            </div>
        </div>
    </section>
}

<Footer />
</div>

@code {
    private WebDesignModel? webDesign;
    private bool ringInitialized;

    // How many cards the hero's 3D ring should hold. Picked to land exactly
    // on "one image from every project, plus a second image from the four
    // strongest" — see SelectRingImages.
    private const int RingCardCount = 12;

    // Hand-curated for the hero ring: which of each project's images best
    // represent it, ranked best-first (index into that project's Images
    // array), plus each project's overall quality rank (1 = strongest) for
    // ordering which projects get a *second* card once every project
    // already has its best one in. Update this by eye when project images
    // change — there's no live scoring here, just a snapshot of a judgment
    // call. (Automating that judgment via the Claude API is possible in
    // principle, but only as a local/offline tool whose output gets
    // committed here, the same pattern BackendTools/RingCuration already uses —
    // never a runtime call from this public, static-hosted page.)
    private static readonly (string Slug, int ProjectRank, int[] ImageIndexesBestFirst)[] RingCuration =
    [
        ("guacamayo-band",         1, [0, 3, 2]), // hero, shows tiles, music/video section
        ("arborkin",               2, [1, 2, 3]), // tree canvas hero, detail drawer, dark mode
        ("dougrosenberg-music-v2", 3, [0, 1]),    // portrait hero, recordings
        ("hardware-etc",           4, [0, 2]),    // hero, real interior/materials photo
        ("sonus-construction",     5, [1]),       // split-panel kitchen photo (stronger than the washed-out hero)
        ("dougrosenberg-music",    6, [3]),       // album covers — avoids duplicating the v2 portrait
        ("haxbyte",                7, [0]),       // hero
        ("gigsync",                8, [0]),       // only image available
    ];

    protected override async Task OnInitializedAsync()
    {
        webDesign = await Http.GetFromJsonAsync<WebDesignModel>("sample-data/webdesign.json");
    }

    // Breadth-first, round-robin: round 0 takes every curated project's best
    // image (in project-quality order), round 1 takes the second-best from
    // whichever projects have one (again in quality order), and so on — so
    // the ring always has full breadth before it ever goes deeper into any
    // single project. At RingCardCount=12 this lands on exactly "one per
    // project (8) + second-best from the top 4," which is what it should.
    private List<string> SelectRingImages(int count)
    {
        if (webDesign is null) return [];

        var bySlug = webDesign.Projects.ToDictionary(p => p.Slug);
        var pools = RingCuration
            .Where(c => bySlug.ContainsKey(c.Slug))
            .OrderBy(c => c.ProjectRank)
            .Select(c => c.ImageIndexesBestFirst.Select(i => bySlug[c.Slug].Images[i]).ToList())
            .ToList();

        var picks = new List<string>();
        for (var round = 0; picks.Count < count; round++)
        {
            var addedAny = false;
            foreach (var pool in pools)
            {
                if (picks.Count >= count) break;
                if (round < pool.Count)
                {
                    picks.Add(pool[round]);
                    addedAny = true;
                }
            }
            if (!addedAny) break; // every curated pool exhausted
        }
        return picks;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ringInitialized && webDesign is not null)
        {
            ringInitialized = true;
            var ringImages = SelectRingImages(RingCardCount);
            await JS.InvokeVoidAsync("DrRing.init", "wd2HeroRing", ringImages);
        }
    }
}
