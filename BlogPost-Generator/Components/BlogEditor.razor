@page "/"
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.Extensions.Configuration
@using BlogPost_Generator.Services
@inject IConfiguration Configuration
@inject BlogPostService BlogService

<div class="generator-page">
    <div class="generator-container">
        <div class="generator-header">
            <h1>📝 Blog Post Generator</h1>
            <p>Write raw thoughts, let Claude polish them</p>
        </div>

        @if (SelectedVersion == null)
        {
            <div class="generator-form">
                <div class="form-group">
                    <label>Post Title</label>
                    <input type="text" class="form-control" @bind="Title" placeholder="e.g., Building Better APIs">
                </div>

                <div class="form-group">
                    <label>Raw Content</label>
                    <textarea class="form-control" rows="10" @bind="Content" placeholder="Paste your raw thoughts here..."></textarea>
                </div>

                <button class="btn btn-primary btn-lg" @onclick="GenerateVersions" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Generating 3 versions...</span>
                    }
                    else
                    {
                        <span>✨ Send to Claude for Polish</span>
                    }
                </button>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger mt-3">
                        @ErrorMessage
                    </div>
                }
            </div>
        }

        @if (Versions.Any())
        {
            <div class="versions-container">
                <div class="versions-header">
                    <h2>Choose Your Best Version</h2>
                    <p>Click one to preview and publish</p>
                </div>

                <div class="versions-grid">
                    @for (int i = 0; i < Versions.Count; i++)
                    {
                        var version = Versions[i];
                        var versionNum = i + 1;

                        <div class="version-card" @onclick="() => SelectVersion(i)">
                            <div class="version-number">Version @versionNum</div>
                            <div class="version-preview">
                                @((MarkupString)TruncateHtml(version, 200))
                            </div>
                            <button class="btn btn-sm btn-outline-primary">View & Select</button>
                        </div>
                    }
                </div>

                <button class="btn btn-secondary" @onclick="ResetForm">← Back to Editor</button>
            </div>
        }

        @if (SelectedVersion != null)
        {
            <div class="modal-overlay" @onclick="DeselectVersion">
                <div class="modal-content" @onclick:stopPropagation="true">
                    <button class="btn-close" @onclick="DeselectVersion"></button>

                    <div class="publish-panel">
                        <div class="publish-preview">
                            <h1>@Title</h1>
                            <time>@DateTime.Now.ToString("MMMM d, yyyy")</time>
                            <div class="content-preview">
                                @((MarkupString)SelectedVersion)
                            </div>
                        </div>

                        <div class="publish-actions">
                            <button class="btn btn-success btn-lg" @onclick="PublishPost" disabled="@IsPublishing">
                                @if (IsPublishing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Publishing...</span>
                                }
                                else
                                {
                                    <span>✓ Publish to Blog</span>
                                }
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="DeselectVersion" disabled="@IsPublishing">Cancel</button>
                        </div>

                        @if (!string.IsNullOrEmpty(PublishMessage))
                        {
                            <div class="alert alert-success mt-3">
                                @PublishMessage
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string Title = string.Empty;
    private string Content = string.Empty;
    private List<string> Versions = new();
    private string? SelectedVersion = null;
    private bool IsLoading = false;
    private bool IsPublishing = false;
    private string? ErrorMessage = null;
    private string? PublishMessage = null;

    private async Task GenerateVersions()
    {
        if (string.IsNullOrWhiteSpace(Title) || string.IsNullOrWhiteSpace(Content))
        {
            ErrorMessage = "Please enter both title and content.";
            return;
        }

        IsLoading = true;
        ErrorMessage = null;
        Versions.Clear();

        try
        {
            Versions = await BlogService.GenerateVersionsAsync(Title, Content);

            if (!Versions.Any())
            {
                ErrorMessage = "Failed to generate versions. Please try again.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void SelectVersion(int index)
    {
        if (index >= 0 && index < Versions.Count)
        {
            SelectedVersion = Versions[index];
            PublishMessage = null;
        }
    }

    private void DeselectVersion()
    {
        SelectedVersion = null;
    }

    private async Task PublishPost()
    {
        if (string.IsNullOrEmpty(SelectedVersion))
            return;

        IsPublishing = true;

        try
        {
            await BlogService.SaveBlogPostAsync(Title, SelectedVersion);
            PublishMessage = "✅ Published! Your post is now live on your blog.";

            await Task.Delay(2000);
            ResetForm();
        }
        catch (Exception ex)
        {
            PublishMessage = $"Error publishing: {ex.Message}";
        }
        finally
        {
            IsPublishing = false;
        }
    }

    private void ResetForm()
    {
        Title = string.Empty;
        Content = string.Empty;
        Versions.Clear();
        SelectedVersion = null;
        ErrorMessage = null;
        PublishMessage = null;
    }

    private string TruncateHtml(string html, int maxLength)
    {
        var text = System.Net.WebUtility.HtmlDecode(
            System.Text.RegularExpressions.Regex.Replace(html, "<[^>]*>", "")
        );
        return text.Length > maxLength ? text.Substring(0, maxLength) + "..." : text;
    }
}

<style>
    .generator-page {
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 3rem 0;
    }

    .generator-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .generator-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .generator-header h1 {
        font-size: 2.5rem;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .generator-header p {
        font-size: 1.1rem;
        color: #666;
    }

    .generator-form {
        background: white;
        border-radius: 12px;
        padding: 2.5rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
        margin-bottom: 2rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    .form-control {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 2px solid #e0e0e0;
        border-radius: 6px;
        font-size: 1rem;
        font-family: inherit;
        transition: border-color 0.3s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: #1abc9c;
        box-shadow: 0 0 0 3px rgba(26, 188, 156, 0.1);
    }

    textarea.form-control {
        resize: vertical;
        min-height: 250px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #1abc9c 0%, #0a9670 100%);
        border: none;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        cursor: pointer;
    }

    .btn-primary:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(26, 188, 156, 0.3);
    }

    .btn-primary:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .versions-container {
        background: white;
        border-radius: 12px;
        padding: 2.5rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    }

    .versions-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .versions-header h2 {
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .versions-header p {
        color: #666;
    }

    .versions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .version-card {
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        padding: 1.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .version-card:hover {
        border-color: #1abc9c;
        box-shadow: 0 8px 16px rgba(26, 188, 156, 0.2);
        transform: translateY(-2px);
    }

    .version-number {
        font-weight: 700;
        color: #1abc9c;
        margin-bottom: 1rem;
        font-size: 0.875rem;
    }

    .version-preview {
        color: #555;
        line-height: 1.6;
        margin-bottom: 1rem;
        font-size: 0.9rem;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 1rem;
    }

    .modal-content {
        background: white;
        border-radius: 12px;
        max-height: 90vh;
        overflow-y: auto;
        max-width: 800px;
        width: 100%;
        position: relative;
    }

    .btn-close {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        z-index: 10;
    }

    .publish-panel {
        padding: 3rem;
    }

    .publish-preview h1 {
        font-size: 2rem;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .publish-preview time {
        color: #999;
        font-size: 0.875rem;
    }

    .content-preview {
        margin-top: 2rem;
        padding: 1.5rem 0;
        border-top: 1px solid #eee;
        border-bottom: 1px solid #eee;
        line-height: 1.8;
        color: #333;
    }

    .content-preview p {
        margin-bottom: 1rem;
    }

    .publish-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
    }

    .btn-success {
        background: #28a745;
        border: none;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        color: white;
        border-radius: 6px;
        cursor: pointer;
    }

    .btn-success:hover:not(:disabled) {
        background: #218838;
        transform: translateY(-2px);
    }

    .btn-outline-secondary {
        border: 2px solid #ccc;
        background: white;
        color: #666;
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 6px;
        cursor: pointer;
    }

    .btn-outline-secondary:hover:not(:disabled) {
        border-color: #999;
        color: #333;
    }

    .alert {
        padding: 1rem;
        border-radius: 6px;
        margin-top: 1rem;
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .alert-success {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .spinner-border {
        display: inline-block;
        width: 1em;
        height: 1em;
        vertical-align: -0.125em;
        border: 0.25em solid currentColor;
        border-right-color: transparent;
        border-radius: 50%;
        animation: spinner-border 0.75s linear infinite;
    }

    @@keyframes spinner-border {
        to { transform: rotate(360deg); }
    }

    @@media (max-width: 768px) {
        .generator-header h1 {
            font-size: 1.75rem;
        }

        .generator-form,
        .versions-container {
            padding: 1.5rem;
        }

        .publish-panel {
            padding: 1.5rem;
        }

        .versions-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
