@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6" Class="ml-3 mr-6">🛠️ Backend Tools</MudText>
        <MudButton Href="/" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Article" Class="mr-2">Blog Generator</MudButton>
        <MudButton Href="/ring-curation" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.ViewInAr">Ring Curation</MudButton>
        <MudSpacer />
    </MudAppBar>
    <MudMainContent>
        <div class="generator-layout">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<style>
    .generator-layout {
        padding: 2rem;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: calc(100vh - 64px);
    }
</style>
